<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores child diary, medical, profile, attachment, and generated backup
  data in private app storage. Keep every storage domain out of legacy Android
  Auto Backup. android:allowBackup="false" is the primary control; the explicit
  exclusions are defense in depth for device implementations that consult rules.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
