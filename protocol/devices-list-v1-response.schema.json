{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlmd.local/protocol/devices-list-v1-response.schema.json",
  "title": "MLMD Devices List v1 Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "devices"
  ],
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "familySpaceId",
          "role",
          "displayName",
          "createdAt",
          "lastSeenAt",
          "revokedAt",
          "isCurrent"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "familySpaceId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "member"]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "revokedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
