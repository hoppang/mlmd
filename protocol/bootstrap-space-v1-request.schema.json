{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlmd.local/protocol/bootstrap-space-v1-request.schema.json",
  "title": "MLMD Bootstrap Space v1 Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "familySpaceId", "deviceId", "deviceDisplayName", "deviceSecret"],
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "familySpaceId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "deviceSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "minLength": 43,
      "maxLength": 43
    }
  }
}
